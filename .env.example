# Lodestar — environment variables
# Copy this file to .env.local and fill in your values. NEVER commit .env.local.

# Google Gemini (Google Gen AI SDK: "@google/genai")
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
EMBED_DIM=1536
# Optional: pin the direct Google endpoint to bypass a host AI gateway that
# lacks the embedding model (e.g. on Netlify set this to the URL below).
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Supabase (Session 2)
# URL and anon key are exposed to the browser, so they use the NEXT_PUBLIC_
# prefix that Next.js requires for client-side env vars.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never import
# it into client code. Find it in Supabase: Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Ingestion (Session 3)
# Shared secret guarding POST /api/ingest. Send it as the x-admin-ingest-token
# header. Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_INGEST_TOKEN=

# Product / observability (Session 7)
# Comma-separated emails allowed to view the /app/metrics dashboard.
ADMIN_EMAILS=
# Seeded demo user id for the public /demo (server-only).
DEMO_USER_ID=
# Optional rate limits (defaults: 20 chat req/min per user, 40 demo req/10min global).
CHAT_RATE_LIMIT_PER_MIN=20
DEMO_RATE_LIMIT=40

# Retrieval (Session 3)
# Cosine similarity a dense-only match must clear to count as grounding, so an
# off-corpus question returns nothing instead of the nearest six strangers.
# Default 0.75, measured against the current corpus — see lib/rag/retrieve.ts.
# Re-measure before changing it; 0 disables the dense floor entirely.
RETRIEVAL_MIN_SIMILARITY=0.75
